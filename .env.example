# =============================================================================
# CivicSignals — root environment template.
# Copy to `.env` (gitignored) and adjust. `make dev` loads this for the stack.
# Per-app overrides live in apps/web/.env.example and apps/api/.env.example.
# =============================================================================

# --- Core ---
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# --- Postgres (via PgBouncer in transaction mode; see doc 06 §4) ---
POSTGRES_USER=civic
POSTGRES_PASSWORD=civic
POSTGRES_DB=civicsignals
# App connects through PgBouncer (6432), not Postgres (5432), by default.
DATABASE_URL=postgresql+asyncpg://civic:civic@pgbouncer:6432/civicsignals
# Direct pool bypass for LISTEN/NOTIFY scheduler + long export jobs.
DATABASE_DIRECT_URL=postgresql+asyncpg://civic:civic@postgres:5432/civicsignals

# --- Redis (Celery broker + cache) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO in dev, S3 in cloud) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=civic
S3_SECRET_ACCESS_KEY=civic-secret
S3_RAW_BUCKET=civic-raw
S3_REGION=us-east-1

# --- Email (Mailpit in dev; Resend/Postmark SMTP in prod; see doc 06 §7) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notifications@civicsignals.io

# --- Auth ---
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=3600
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- LLM gateway (BYO key on Core; multi-model routed on Cloud; doc 06 §7) ---
# Vendor SDKs are imported lazily; only set keys for providers you use.
LLM_DEFAULT_PROVIDER=anthropic     # anthropic | openai | ollama
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MAX_ATTEMPTS=3                 # retry attempts (incl. first) on transient errors
# Per-task model overrides as JSON (task -> "provider:model" or "model"):
# LLM_TASK_MODELS={"classify":"anthropic:claude-3-5-haiku-latest"}

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
