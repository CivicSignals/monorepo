# =============================================================================
# CivicSignals — self-host environment template (task O2).
#
# Copy to infra/.env and fill in all values marked CHANGE_ME before running:
#
#   cp infra/.env.example infra/.env
#   $EDITOR infra/.env
#   docker compose -f infra/docker-compose.yml --env-file infra/.env up -d
#   docker compose -f infra/docker-compose.yml --env-file infra/.env run --rm init
#
# Variable reference: docs/self-host/config.md (task O4).
# SPDX-License-Identifier: AGPL-3.0-only
# =============================================================================

# -----------------------------------------------------------------------------
# Image versioning
# Set to a specific release tag (e.g. "v0.1.0") or leave "latest" to always
# pull the newest published image from GHCR. Use BUILD_FROM_SOURCE=1 to build
# locally instead of pulling (useful on dev branches without published images).
# -----------------------------------------------------------------------------
CIVIC_VERSION=latest
# BUILD_FROM_SOURCE=1

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# Ports exposed by the nginx reverse proxy on the host.
HTTP_PORT=80
HTTPS_PORT=443

# Public domain (used by the app for link generation, CORS, cookies, etc.)
CIVIC_BASE_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Postgres (doc 06 §4)
# App processes connect via PgBouncer (port 6432) — see DATABASE_URL below.
# Alembic + long-running jobs use DATABASE_DIRECT_URL (port 5432) to bypass
# PgBouncer's transaction-mode restrictions.
# -----------------------------------------------------------------------------
POSTGRES_USER=civic
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=civicsignals

# App connection — routes through PgBouncer in transaction mode.
DATABASE_URL=postgresql+asyncpg://civic:CHANGE_ME_strong_random_password@pgbouncer:6432/civicsignals

# Direct connection — bypasses PgBouncer for Alembic, LISTEN/NOTIFY, exports.
DATABASE_DIRECT_URL=postgresql+asyncpg://civic:CHANGE_ME_strong_random_password@postgres:5432/civicsignals

# -----------------------------------------------------------------------------
# Redis (Celery broker + result backend + cache; doc 06 §4)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Object storage (doc 06 §4)
#
# DEFAULT: MinIO running inside the stack.
# Set S3_ENDPOINT_URL to the MinIO internal address (http://minio:9000).
#
# EXTERNAL S3: point to your bucket provider (AWS, Cloudflare R2, Backblaze B2,
# etc.) and remove the `minio` and `minio-init` services from docker-compose.yml.
# Leave S3_ENDPOINT_URL empty for native AWS S3.
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=CHANGE_ME_minio_or_aws_access_key
S3_SECRET_ACCESS_KEY=CHANGE_ME_minio_or_aws_secret_key
S3_RAW_BUCKET=civic-raw
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Email / SMTP (doc 06 §7)
# Self-hosters can point this at any SMTP server.
# Cloud: Resend or Postmark. Dev: Mailpit (see docker-compose.dev.yml).
# Leave SMTP_USER / SMTP_PASSWORD empty for servers that don't require auth.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_username
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Auth / Security (doc 06 §6)
# SECRET_KEY must be a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(64))"
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_64
# JWT_SECRET is optional; falls back to SECRET_KEY when unset (task B1).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=civicsignals
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
# Require email verification before login (off by default; Cloud sets true).
REQUIRE_EMAIL_VERIFICATION=false
# Base URL of the web app — builds the verification email link.
WEB_BASE_URL=http://localhost:3000

# Google OAuth (optional; leave empty to disable Google sign-in — task B2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Initial admin account (used by `docker compose run --rm init`; task O2)
# These credentials seed the first admin user (B1 — wired) on first boot.
# TODO B5: workspace seeding is fully wired once workspace models land.
# -----------------------------------------------------------------------------
CIVICSIGNALS_ADMIN_EMAIL=admin@example.com
CIVICSIGNALS_ADMIN_PASSWORD=CHANGE_ME_admin_password

# -----------------------------------------------------------------------------
# LLM gateway (doc 06 §7)
# Self-hosters can use any supported provider. Ollama (local) is free.
# BYO key — the key is never sent to CivicSignals servers.
# Providers: anthropic | openai | ollama
# -----------------------------------------------------------------------------
LLM_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# NEXT_PUBLIC_API_BASE_URL must be reachable from the browser — it's the public
# URL of the API (via nginx), not the container-internal address.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://app.example.com/api/v1

# -----------------------------------------------------------------------------
# Telemetry (task O6 — opt-in only)
# Off by default. Set to "true" to send anonymous usage pings that fund recipe
# quality improvements. We never send signal content or PII.
# -----------------------------------------------------------------------------
CIVICSIGNALS_TELEMETRY=false

# -----------------------------------------------------------------------------
# Sentry (optional; task LC-15)
# Leave empty to disable error tracking. Self-hosters can point this at a
# self-hosted Sentry or GlitchTip instance.
# -----------------------------------------------------------------------------
SENTRY_DSN=
