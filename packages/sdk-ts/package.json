{
  "name": "@civicsignals/sdk-ts",
  "version": "0.1.0",
  "description": "TypeScript client for the CivicSignals REST API. Types generated from /api/v1/openapi.json.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript http://localhost:8000/api/v1/openapi.json -o src/generated/schema.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.2"
  }
}
