# API environment. In dev these are provided by the root .env / docker-compose.
# Copy to .env for running the API outside the compose stack.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://civic:civic@localhost:6432/civicsignals
DATABASE_DIRECT_URL=postgresql+asyncpg://civic:civic@localhost:5432/civicsignals
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
S3_ENDPOINT_URL=http://localhost:9000
S3_RAW_BUCKET=civic-raw
SMTP_HOST=localhost
SMTP_PORT=1025
SECRET_KEY=dev-only-change-me
# LLM gateway (doc 06 §7). Vendor SDKs are imported lazily; only set the keys
# for providers you actually use. Self-hosters can point everything at Ollama.
LLM_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MAX_ATTEMPTS=3
# Per-task model overrides as JSON (task -> "provider:model" or "model").
# LLM_TASK_MODELS={"classify":"anthropic:claude-3-5-haiku-latest"}
