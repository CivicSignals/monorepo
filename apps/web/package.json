{
  "name": "@civicsignals/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "e2e": "playwright test --project=chromium-full",
    "e2e:smoke": "playwright test --project=chromium-smoke",
    "e2e:matrix": "playwright test --project=chromium --project=firefox --project=webkit",
    "e2e:matrix:smoke": "playwright test --project=chromium-smoke --project=firefox-smoke --project=webkit-smoke",
    "e2e:firefox": "playwright test --project=firefox-full",
    "e2e:firefox:smoke": "playwright test --project=firefox-smoke",
    "e2e:webkit": "playwright test --project=webkit-full",
    "e2e:webkit:smoke": "playwright test --project=webkit-smoke",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@civicsignals/sdk-ts": "workspace:*",
    "@dnd-kit/core": "^6",
    "@dnd-kit/utilities": "^3",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "next": "15.5.18",
    "react": "19.2.6",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-config-next": "15.5.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
